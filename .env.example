# --- Vermilion application -----------------------------------------
VERMILION_ADDR=:8080
VERMILION_PG_DSN=postgres://vermilion:vermilion@vermilion-postgres:5432/vermilion?sslmode=disable
# 32-byte key for encrypting Redmine API keys at rest.
# Generate with: openssl rand -hex 32
VERMILION_ENCRYPTION_KEY=devdevdevdevdevdevdevdevdevdevde
# Set to true outside the dev compose stack so cookies travel only over HTTPS.
VERMILION_COOKIE_SECURE=false
VERMILION_REDMINE_BASE_URL=http://redmine:3000
# Replace with the real API key copied from the running Redmine admin account.
VERMILION_REDMINE_API_KEY=replace-me-from-redmine-admin

# --- Vermilion Postgres --------------------------------------------
VERMILION_PG_USER=vermilion
VERMILION_PG_PASSWORD=vermilion
VERMILION_PG_DB=vermilion

# --- Local Redmine -------------------------------------------------
REDMINE_DB_USER=redmine
REDMINE_DB_PASSWORD=redmine
REDMINE_DB_NAME=redmine
# Placeholder only. Generate a real secret for any non-local use.
REDMINE_SECRET_KEY_BASE=change-me-for-real-deployments-only

# --- Redmine seed (docker compose --profile seed up redmine-seed) --
REDMINE_ADMIN_USER=admin
REDMINE_ADMIN_PASS=admin
# Set RESET=true to delete all projects/users before seeding.
RESET=false

# --- Vite dev server (frontend container) --------------------------
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
